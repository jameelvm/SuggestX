{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Aggregator": {
    "PollIntervalSeconds": 15
  },
  "Aws": {
    "ServiceUrl": "http://localhost:4567",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "Storage": {
    "RawLogsBucket": "suggestx-raw-logs",
    "TrieSnapshotsBucket": "suggestx-trie-snapshots"
  },
  "Dynamo": {
    "PhraseFrequenciesTable": "suggestx-phrase-frequencies"
  },
  "ZooKeeper": {
    "ConnectionString": "localhost:2181",
    "RootPath": "/suggestx"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6380"
  }
}
