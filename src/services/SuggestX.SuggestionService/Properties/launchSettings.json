{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    // Same port the container publishes (9081) — stop the container first,
    // or this fails to bind. See DEBUGGING.md.
    "SuggestionService (local)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "scalar",
      "applicationUrl": "http://localhost:9081",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
