{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "TrieBuilder": {
    "BuildIntervalSeconds": 20,
    "MaxPrefixLength": 6,
    "TopN": 10
  },
  "Aws": {
    "ServiceUrl": "http://localhost:4567",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "Storage": {
    "RawLogsBucket": "suggestx-raw-logs",
    "TrieSnapshotsBucket": "suggestx-trie-snapshots"
  },
  "Firehose": {
    "SearchEventsStream": "suggestx-search-events"
  },
  "Dynamo": {
    "PhraseFrequenciesTable": "suggestx-phrase-frequencies"
  },
  "ZooKeeper": {
    "ConnectionString": "localhost:2181",
    "RootPath": "/suggestx",
    "SessionTimeoutMs": 10000
  },
  "ConnectionStrings": {
    "Redis": "localhost:6380"
  }
}
