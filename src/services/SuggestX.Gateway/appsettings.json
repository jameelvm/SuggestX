{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Aws": {
    "ServiceUrl": "http://localhost:4567",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6380"
  },

  "ReverseProxy": {
    "Routes": {
      "suggestions": {
        "ClusterId": "suggestionService",
        "Match": { "Path": "/api/suggestions/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "search-events": {
        "ClusterId": "collectionService",
        "Match": { "Path": "/api/search-events/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "suggestionService": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Destinations": {
          "container": { "Address": "http://localhost:8081/" }
        }
      },
      "collectionService": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Destinations": {
          "container": { "Address": "http://localhost:8082/" }
        }
      }
    }
  }
}
