{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Aws": {
    "ServiceUrl": "http://localhost:4567",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6380"
  },

  "ReverseProxy": {
    "Routes": {
      "suggestions": {
        "ClusterId": "suggestionService",
        "Match": { "Path": "/api/suggestions/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "search-events": {
        "ClusterId": "collectionService",
        "Match": { "Path": "/api/search-events/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    // Each routed cluster has ONE destination, addressed by port number
    // only — not by which process (container or local debugger) happens to
    // be holding that port. Local debug profiles reuse the exact port the
    // container publishes (see each service's launchSettings.json), so
    // container and local can never both be bound at once; whichever is
    // currently running is simply whatever answers at that address.
    //
    // An earlier version of this file tried the classic dual-destination
    // failover pattern ("container" + "local" as two separate entries,
    // FirstAlphabetical to prefer one). That's the right shape when local
    // and container run on genuinely different ports (see the sibling
    // JameX project). Here, with same-numbered ports, it was empirically
    // proven to route correctly either way but pick a destination label
    // inconsistently even while both were healthy — because both labels
    // resolve to the identical backend whenever the container is up (its
    // own port-forward answers the "local" address too). Harmless, but
    // needlessly confusing to read and impossible to honestly document as
    // "deterministic." One destination removes the question entirely.
    //
    // This address is for a Gateway running on the host. When the Gateway
    // runs in compose, its environment variables replace it with a
    // host.docker.internal-style address — see DEBUGGING.md.
    "Clusters": {
      "suggestionService": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "instance": { "Address": "http://localhost:9081/" }
        }
      },
      "collectionService": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "instance": { "Address": "http://localhost:9082/" }
        }
      }
    }
  }
}
