{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    // When the Gateway runs here, its cluster destinations come from
    // appsettings.json — which lists both the container address and the
    // local debug address for every routed service, and health-checks both.
    "Gateway (local)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:9080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
